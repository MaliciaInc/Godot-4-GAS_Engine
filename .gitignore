.godot/
.import/
*.translation

# Python bytecode from the quality-gate test suite.
# Completion criterion 73 requires `git status --short` to be clean when the
# phase is sealed, and running the gate self-tests produces these on every run.
__pycache__/
*.py[cod]

# Volatile GUT scratch receipt. The durable one is copied into
# artifacts/gates/<TaskId>/ by the task that ran it.
artifacts/gut/
