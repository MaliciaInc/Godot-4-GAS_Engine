; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GAS_Engine"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]






GameplayCueManager="*res://addons/GAS_Engine/managers/gameplay_cue_manager.gd"

[debug]

; Godot excludes addons/** from GDScript warnings by default. The addon's own
; code is held to the eight settings below and is validated against them; the
; test dependency vendored alongside it is not strictly typed and is not part
; of the product's typing contract. The exclusion therefore stays on here, and
; turning it off makes the vendored dependency fail to parse and takes the test
; suite with it.
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/inference_on_variant=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[editor_plugins]

enabled=PackedStringArray("res://addons/GAS_Engine/plugin.cfg", "res://addons/gut/plugin.cfg")
