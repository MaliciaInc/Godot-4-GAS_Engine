; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arhalies GAS"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]




GameplayCueManager="*res://addons/GodotGAS/managers/gameplay_cue_manager.gd"

[debug]

; Godot excludes addons/** from GDScript warnings by DEFAULT, which silently
; exempted the entire engine - it lives in addons/GodotGAS - from the eight
; settings below. Setting this to false is correct for our code and impossible
; for the project as a whole: addons/gut is a vendored dependency pinned
; byte-identical by step 11.6, is not strictly typed, and fails to parse under
; the strict setting, taking the test suite with it.
;
; So the project runs permissive and is verified strict:
;     python tooling/strict_typing_pass.py enter
;     <validate addons/GodotGAS/** through the Godot MCP>
;     python tooling/strict_typing_pass.py leave
;
; Neither mode weakens a warning. Only the trees they apply to differ.
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
