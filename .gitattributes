# Normalize every text file to LF in the repository AND in working copies.
# Not a preference: content that is hashed or diffed has to be the same bytes
# on every platform, and a checkout that rewrote line endings would differ
# from the one it was verified against without a single line having changed.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.pdf binary
*.import text eol=lf
